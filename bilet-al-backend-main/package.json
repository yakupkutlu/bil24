{
  "name": "tiatru-backend",
  "version": "1.0.0",
  "description": "Production-ready backend API for Tiatru — Modern Tiyatro Bilet Satış Sistemi",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "cleanup:locks": "node src/jobs/expireSeatLocks.job.js",
    "check": "node --check src/server.js && node --check src/app.js"
  },
  "keywords": [
    "tiatru",
    "theater",
    "ticketing",
    "express",
    "mongodb",
    "mongoose"
