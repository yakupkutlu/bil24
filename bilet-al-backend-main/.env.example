# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=false

# Database
MONGO_URI=mongodb://127.0.0.1:27017/tiatru

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
REFRESH_COOKIE_NAME=tiatru_refresh

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Optional Redis seat lock backend. MongoDB TTL is used by default.
REDIS_URL=

# Payment placeholders
DEFAULT_CURRENCY=TRY
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret

# Email / SMS placeholders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Tiatru <noreply@tiatru.com>"
SMS_PROVIDER=
SMS_API_KEY=

# Media
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:5000
MAX_UPLOAD_MB=5
